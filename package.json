{
  "name": "@venespana/opencode-vision",
  "version": "0.1.1",
  "description": "OpenCode plugin: vision for text-only models — intercepts pasted images, materializes to disk, routes to a VisionBackend, injects description back into chat context.",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venespana/opencode-vision.git"
  },
  "homepage": "https://github.com/venespana/opencode-vision#readme",
  "bugs": {
    "url": "https://github.com/venespana/opencode-vision/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "vision",
    "image",
    "mcp",
    "minimax",
    "accessibility"
  ],
  "author": "venespana",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@opencode-ai/plugin": "^1.18.0",
    "@opencode-ai/sdk": "^1.18.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.4.0",
    "strip-json-comments": "^5.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "zod": "^3.23.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build": "tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check src/**/*.ts"
  },
  "license": "AGPL-3.0"
}
